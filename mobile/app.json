{
  "expo": {
    "name": "ASAAN",
    "slug": "handyhive",
    "scheme": "handyhive",
    "version": "0.1.0",
    "orientation": "portrait",
    "web": { "output": "single" },
    "android": { "package": "com.handyhive.app" },
    "ios": { "bundleIdentifier": "com.handyhive.app" },
    "plugins": ["expo-router", "expo-secure-store", ["expo-location", {
      "locationWhenInUsePermission": "Use your location to find the visit area and workers who serve it."
    }], "./plugins/with-android-cmake"]
  }
}
