# Same-origin connected website and API. Keep secrets in the host's secret store.
HANDYHIVE_PUBLIC_ORIGIN=https://your-asaan-domain.example
HANDYHIVE_DB=/data/handyhive.sqlite
HANDYHIVE_PHONE_MODE=twilio
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# ASAAN's own Firebase project (public web app configuration).
HANDYHIVE_FIREBASE_API_KEY=
HANDYHIVE_FIREBASE_AUTH_DOMAIN=
HANDYHIVE_FIREBASE_PROJECT_ID=
HANDYHIVE_FIREBASE_APP_ID=
HANDYHIVE_FIREBASE_MESSAGING_SENDER_ID=

# Optional server-only credential for token revocation checks. Store the complete
# service account JSON as one secret value, or use GOOGLE_APPLICATION_CREDENTIALS.
HANDYHIVE_FIREBASE_SERVICE_ACCOUNT_JSON=
